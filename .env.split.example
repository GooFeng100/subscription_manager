# Copy this file to .env for local split testing.
# Real runtime secrets must not be committed to Git.

NODE_ENV=production
PORT=3000
APP_BASE_URL=http://localhost:8084
MONGODB_URI=mongodb://mongodb:27017/subscription_manager
REDIS_URL=redis://redis:6379
CONVERTER_BACKEND_URL=http://subconverter:25500/sub
SESSION_COOKIE_SECURE=false
SESSION_SECRET=please-change-me
JWT_SECRET=please-change-me
SESSION_COOKIE_NAME=sm_session
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me
TURNSTILE_ENABLED=false
REGISTRATION_ENABLED=false
REGISTER_ENABLED=false

LOGIN_FAIL_LIMIT=5
LOGIN_LOCK_MINUTES=15
REGISTER_IP_LIMIT=10
REGISTER_IP_WINDOW_MINUTES=60
SUB_RATE_LIMIT_PER_MINUTE=60
UPSTREAM_POLL_INTERVAL_MINUTES=60
SUB_CONVERTER_TIMEOUT_MS=10000
UPSTREAM_FETCH_PROXY_URL=
CONVERTER_SOURCE_SECRET=change-me-internal-source-secret
LOGIN_TURNSTILE_ENABLED=false
REGISTER_TURNSTILE_ENABLED=false
REDEEM_TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
